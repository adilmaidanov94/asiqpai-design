{
  "$meta": {
    "name": "ASIQPAI Design Tokens",
    "version": "1.0",
    "date": "2026-10-14",
    "theme": "dark-fixed",
    "source": "assets/css/tokens.css",
    "format": "W3C-DTCG-like; values are CSS strings"
  },
  "color": {
    "bg": {
      "$value": "#0E0D0B",
      "$type": "color"
    },
    "surface-1": {
      "$value": "#171613",
      "$type": "color"
    },
    "surface-2": {
      "$value": "#201E1A",
      "$type": "color"
    },
    "surface-3": {
      "$value": "#2A2823",
      "$type": "color"
    },
    "line": {
      "$value": "rgba(242, 226, 190, 0.08)",
      "$type": "color"
    },
    "line-strong": {
      "$value": "rgba(242, 226, 190, 0.16)",
      "$type": "color"
    },
    "fg": {
      "$value": "#F4EFE4",
      "$type": "color"
    },
    "fg-2": {
      "$value": "#B9B2A3",
      "$type": "color"
    },
    "fg-3": {
      "$value": "#847E71",
      "$type": "color"
    },
    "gold": {
      "$value": "#D9AE52",
      "$type": "color"
    },
    "gold-hi": {
      "$value": "#F0CF7E",
      "$type": "color"
    },
    "gold-lo": {
      "$value": "#A67C2B",
      "$type": "color"
    },
    "gold-ink": {
      "$value": "#1A1408",
      "$type": "color"
    },
    "gold-wash": {
      "$value": "rgba(217, 174, 82, 0.12)",
      "$type": "color"
    },
    "gold-line": {
      "$value": "rgba(217, 174, 82, 0.40)",
      "$type": "color"
    },
    "gold-grad": {
      "$value": "linear-gradient(135deg, #F0CF7E 0%, #D9AE52 45%, #B48834 100%)",
      "$type": "gradient"
    },
    "trk-mid": {
      "$value": "#D9AE52",
      "$type": "color"
    },
    "trk-back": {
      "$value": "#79A6D2",
      "$type": "color"
    },
    "trk-adlibs": {
      "$value": "#D97A9B",
      "$type": "color"
    },
    "trk-beat": {
      "$value": "#8C8676",
      "$type": "color"
    },
    "success": {
      "$value": "#4CC38A",
      "$type": "color"
    },
    "success-wash": {
      "$value": "rgba(76, 195, 138, 0.12)",
      "$type": "color"
    },
    "warning": {
      "$value": "#F2A93B",
      "$type": "color"
    },
    "warning-wash": {
      "$value": "rgba(242, 169, 59, 0.12)",
      "$type": "color"
    },
    "danger": {
      "$value": "#F0605D",
      "$type": "color"
    },
    "danger-wash": {
      "$value": "rgba(240, 96, 93, 0.12)",
      "$type": "color"
    },
    "info": {
      "$value": "#79A6D2",
      "$type": "color"
    },
    "info-wash": {
      "$value": "rgba(121, 166, 210, 0.12)",
      "$type": "color"
    },
    "rec": {
      "$value": "#F0605D",
      "$type": "color"
    },
    "scrim": {
      "$value": "rgba(6, 5, 4, 0.72)",
      "$type": "color"
    }
  },
  "typography": {
    "font-display": {
      "$value": "\"Unbounded\", \"Arial Black\", system-ui, sans-serif",
      "$type": "fontFamily"
    },
    "font-body": {
      "$value": "\"Onest\", -apple-system, \"Segoe UI\", Roboto, system-ui, sans-serif",
      "$type": "fontFamily"
    },
    "font-mono": {
      "$value": "\"JetBrains Mono\", ui-monospace, \"SF Mono\", Menlo, monospace",
      "$type": "fontFamily"
    },
    "ts": {
      "$value": "1",
      "$type": "number"
    },
    "fs-display": {
      "$value": "calc(30px * var(--ts))",
      "$type": "dimension"
    },
    "fs-h1": {
      "$value": "calc(24px * var(--ts))",
      "$type": "dimension"
    },
    "fs-h2": {
      "$value": "calc(19px * var(--ts))",
      "$type": "dimension"
    },
    "fs-h3": {
      "$value": "calc(16px * var(--ts))",
      "$type": "dimension"
    },
    "fs-body": {
      "$value": "calc(15px * var(--ts))",
      "$type": "dimension"
    },
    "fs-sm": {
      "$value": "calc(13px * var(--ts))",
      "$type": "dimension"
    },
    "fs-xs": {
      "$value": "calc(12px * var(--ts))",
      "$type": "dimension"
    },
    "fs-label": {
      "$value": "calc(11px * var(--ts))",
      "$type": "dimension"
    },
    "lh-tight": {
      "$value": "1.15",
      "$type": "number"
    },
    "lh-snug": {
      "$value": "1.3",
      "$type": "number"
    },
    "lh-body": {
      "$value": "1.47",
      "$type": "number"
    }
  },
  "spacing": {
    "s-1": {
      "$value": "4px",
      "$type": "dimension"
    },
    "s-2": {
      "$value": "8px",
      "$type": "dimension"
    },
    "s-3": {
      "$value": "12px",
      "$type": "dimension"
    },
    "s-4": {
      "$value": "16px",
      "$type": "dimension"
    },
    "s-5": {
      "$value": "20px",
      "$type": "dimension"
    },
    "s-6": {
      "$value": "24px",
      "$type": "dimension"
    },
    "s-8": {
      "$value": "32px",
      "$type": "dimension"
    },
    "s-10": {
      "$value": "40px",
      "$type": "dimension"
    },
    "s-12": {
      "$value": "48px",
      "$type": "dimension"
    },
    "gutter": {
      "$value": "16px",
      "$type": "dimension"
    }
  },
  "radius": {
    "r-xs": {
      "$value": "6px",
      "$type": "dimension"
    },
    "r-sm": {
      "$value": "10px",
      "$type": "dimension"
    },
    "r-md": {
      "$value": "14px",
      "$type": "dimension"
    },
    "r-lg": {
      "$value": "20px",
      "$type": "dimension"
    },
    "r-xl": {
      "$value": "28px",
      "$type": "dimension"
    },
    "r-full": {
      "$value": "999px",
      "$type": "dimension"
    }
  },
  "size": {
    "touch": {
      "$value": "44px",
      "$type": "dimension"
    },
    "appbar-h": {
      "$value": "56px",
      "$type": "dimension"
    },
    "tabbar-h": {
      "$value": "64px",
      "$type": "dimension"
    },
    "miniplayer-h": {
      "$value": "60px",
      "$type": "dimension"
    }
  },
  "shadow": {
    "shadow-1": {
      "$value": "0 1px 0 rgba(255, 255, 255, 0.03) inset, 0 6px 16px rgba(0, 0, 0, 0.35)",
      "$type": "shadow"
    },
    "shadow-sheet": {
      "$value": "0 -16px 48px rgba(0, 0, 0, 0.55)",
      "$type": "shadow"
    },
    "glow-gold": {
      "$value": "0 0 0 1px var(--gold-line), 0 10px 28px rgba(217, 174, 82, 0.20)",
      "$type": "shadow"
    }
  },
  "motion": {
    "ease-out": {
      "$value": "cubic-bezier(0.2, 0.8, 0.2, 1)",
      "$type": "cubicBezier"
    },
    "ease-in-out": {
      "$value": "cubic-bezier(0.6, 0, 0.3, 1)",
      "$type": "cubicBezier"
    },
    "d-fast": {
      "$value": "120ms",
      "$type": "duration"
    },
    "d-base": {
      "$value": "200ms",
      "$type": "duration"
    },
    "d-slow": {
      "$value": "320ms",
      "$type": "duration"
    }
  }
}